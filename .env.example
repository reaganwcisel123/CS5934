# Copy this file to `.env` and fill in your key(s), then load it when running, e.g.:
#     uv run --env-file .env python src/build_dataset.py --refresh
# `.env` is git-ignored -- never commit real keys.

# --- Census Data API — REQUIRED for the ACS + population sources ---
# Free, takes ~1 minute: https://api.census.gov/data/key_signup.html
# Unlocks:
#   census_acs_sdoh            -> economic + education domains, poverty/uninsured
#   county_population_estimates -> county population (dashboard "patients")
# Without it those fields stay stubbed (build prints them under STUB).
CENSUS_API_KEY=

# --- HRSA web services — NOT required as wired ---
# The pipeline uses HRSA's keyless bulk CSV download, so leave this blank.
# Only needed if you switch hrsa_hpsa to HRSA's registered web-services API.
# Register at: https://data.hrsa.gov/
# HRSA_WEB_SERVICES_REGISTRATION=

# --- Render Postgres (Phase 1 platform) ---
# Create a Postgres instance in the Render dashboard (or via render.yaml).
# DATABASE_URL is the connection string Render provides. Used by the FastAPI
# backend, the migration runner, and `build_dataset.py --seed --to-db`.
# On Render this is injected automatically (fromDatabase in render.yaml);
# locally, paste the *External* connection string here.
# Without it, the API falls back to dashboard/data/clinic_atlas.json (dev).
DATABASE_URL=

# --- Auth (Phase 3) ---
# Secret used to sign JWT session tokens. Generate a long random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Explainer chatbot (Phase 4) ---
# Anthropic API key for the grounded county explainer. Without it, /api/chat
# returns 503 and the dashboard hides the assistant. https://console.anthropic.com
ANTHROPIC_API_KEY=
# --- Funding Matches Gemini ranking (server-side only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional model override (default: claude-opus-4-8).
# ATLAS_CHAT_MODEL=claude-opus-4-8
# Per-user (or per-IP) rate limit for /api/chat. Defaults: 20 questions / 60s.
# In-process only, so it resets on restart and does not span multiple instances.
# ATLAS_CHAT_RATE_MAX=20
# ATLAS_CHAT_RATE_WINDOW=60

# Copy this file to `.env` and fill in your key(s), then load it when running, e.g.:
#     uv run --env-file .env python src/build_dataset.py --refresh
# `.env` is git-ignored -- never commit real keys.

# --- Census Data API — REQUIRED for the ACS + population sources ---
# Free, takes ~1 minute: https://api.census.gov/data/key_signup.html
# Unlocks:
#   census_acs_sdoh            -> economic + education domains, poverty/uninsured
#   county_population_estimates -> county population (dashboard "patients")
# Without it those fields stay stubbed (build prints them under STUB).
CENSUS_API_KEY=

# --- HRSA web services — NOT required as wired ---
# The pipeline uses HRSA's keyless bulk CSV download, so leave this blank.
# Only needed if you switch hrsa_hpsa to HRSA's registered web-services API.
# Register at: https://data.hrsa.gov/
# HRSA_WEB_SERVICES_REGISTRATION=

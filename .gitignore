# Cached raw source extracts (regenerated by `python src/build_dataset.py --refresh`).
# Kept out of git because upstream files (HRSA, USDA) are tens of MB each.
data/raw/*
!data/raw/.gitkeep

# Derived surveillance history (regenerated by `python -m src.ingestion.cdc_nndss`).
data/processed/*
!data/processed/.gitkeep

# Generated dashboard dataset (build output of src/build_dataset.py).
# Regenerate with `uv run python src/build_dataset.py`; the live dashboard
# falls back to synthetic data when it is absent.
dashboard/data/clinic_atlas.json
!dashboard/data/.gitkeep

# Trained model artifacts + metrics (regenerated by `python -m src.model.train`).
models/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Local secrets (e.g. CENSUS_API_KEY) -- never commit
.env

# Design-system source kit (local reference only). The dashboard uses the
# vendored subset in dashboard/ds/ instead.
Triad Health Engine Design System/
